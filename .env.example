# Copy to `.env` and fill in what you need. Everything here is optional —
# the app runs with sane defaults and no .env at all. All vars are prefixed
# FDPLANNER_. Never commit your real .env (it's git-ignored).

# --- Planning ---------------------------------------------------------------
# Weekly spend cap in dollars (also settable per-run in the dashboard).
# FDPLANNER_WEEKLY_BUDGET=200

# --- Local AI and household meal planning ------------------------------------
FDPLANNER_AI_PROVIDER=ollama
FDPLANNER_OLLAMA_URL=http://127.0.0.1:11434
FDPLANNER_PLANNER_MODEL=qwen3.6:35b-a3b-q4_K_M
FDPLANNER_AI_CONTEXT_TOKENS=16384
FDPLANNER_AI_TIMEOUT_SECONDS=90
# Set provider to disabled for fully heuristic operation. Local errors NEVER
# trigger cloud fallback. Legacy Anthropic is explicit opt-in: provider=anthropic,
# an Anthropic model, and FDPLANNER_ANTHROPIC_API_KEY_FILE.
# FDPLANNER_RECIPES_FILE=/recipes/house-recipes.json
# Names of things the household confirms are on hand, one per line.
# FDPLANNER_PANTRY_FILE=/pantry/pantry.txt
FDPLANNER_MEAL_COUNT=3
# Keep coordinates out of git; approximate coordinates are sent to Open-Meteo; missing coordinates simply disable weather context.
# FDPLANNER_WEATHER_LATITUDE=
# FDPLANNER_WEATHER_LONGITUDE=
FDPLANNER_PLANNING_TIMEZONE=America/New_York

# --- JSON API (/api/*) -------------------------------------------------------
# Bearer token for the JSON API, read from a file. Home Assistant uses this to
# post shopping-list items and read the draft's status. With no file set, /api
# refuses every request; the HTML dashboard is unaffected and stays open.
# FDPLANNER_API_TOKEN_FILE=/run/secrets/fdplanner_api_token

# --- Review dashboard / email digest ----------------------------------------
# Base URL the digest email deep-links to.
# FDPLANNER_DASHBOARD_URL=http://127.0.0.1:8000
# SMTP for the weekly digest. With no SMTP set, the digest is written as an
# HTML preview under data/digests/ instead of being emailed.
# FDPLANNER_SMTP_HOST=smtp.gmail.com
# FDPLANNER_SMTP_PORT=587
# FDPLANNER_SMTP_USER=you@example.com
# FDPLANNER_SMTP_PASSWORD=your-app-password
# FDPLANNER_DIGEST_FROM=you@example.com
# FDPLANNER_DIGEST_TO=household-manager@example.com

# --- Weekly scheduler (needs the `scheduler` extra) -------------------------
# FDPLANNER_SCHEDULE_DAY=fri        # mon..sun — day the draft+digest run
# FDPLANNER_SCHEDULE_HOUR=7         # 0..23, local time
# FDPLANNER_SCHEDULE_HORIZON_DAYS=7
# FDPLANNER_SCHEDULE_MAX_ITEMS=25

# --- Preferred delivery window ----------------------------------------------
# The "ideal" delivery the planner suggests on each draft (prefilled + shown in
# the digest/dashboard). FreshDirect slots are reserved at checkout, so this is
# a recorded preference, not a held slot. Default: Sunday evening after 7pm.
# FDPLANNER_PREFERRED_DELIVERY_DAY=sun           # mon..sun
# FDPLANNER_PREFERRED_DELIVERY_AFTER_HOUR=19     # 0..23 (19 = after 7pm)

# --- Browser / scraping (advanced) ------------------------------------------
# Real Google Chrome is driven by default (channel below). Set headless=false
# to watch a run. data_dir holds the SQLite DB and the persistent Chrome profile.
# FDPLANNER_BROWSER_CHANNEL=chrome
# FDPLANNER_HEADLESS=true
# FDPLANNER_DATA_DIR=./data
